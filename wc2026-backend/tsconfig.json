{
  "compilerOptions": {
    "target": "ES2022",                                  /* Versión de JavaScript a la que se compilará */
    "module": "CommonJS",                                /* Sistema de módulos para Node.js */
    "moduleResolution": "bundler",
    "outDir": "./dist",                                  /* Carpeta donde se guardará el código compilado */
    "rootDir": "./src",                                  /* Carpeta donde está tu código fuente */
    "strict": true,                                      /* Activa todas las comprobaciones estrictas de TS */
    "esModuleInterop": true,                             /* Compatibilidad con módulos CommonJS */
    "skipLibCheck": true,                                /* Evita chequear los tipos de las librerías (hace que compile más rápido) */
    "forceConsistentCasingInFileNames": true,
    
    "experimentalDecorators": true,                      /* Habilita el uso de @Decoradores */
    "emitDecoratorMetadata": true,                       /* Permite que TypeORM lea los tipos de datos */
    "strictPropertyInitialization": false                /* Evita que TS te obligue a inicializar las variables en el constructor (ideal para TypeORM) */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}